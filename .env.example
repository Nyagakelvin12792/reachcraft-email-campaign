# Gmail SMTP Configuration
# NOTE: Never commit your actual Google App Password to source control.
# Generate an App Password in your Google Account:
# Security > 2-Step Verification > App passwords (select 'Mail')
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_NAME=Campaign Manager

# Application & Database Configuration
PORT=3001
# Local development uses SQLite. Vercel must use a persistent PostgreSQL URL.
DATABASE_URL=file:./dev.db
APP_ENCRYPTION_KEY=replace_with_a_secure_32_char_random_key_here

# Sending Engine Constraints
# Delay between individual personalized emails (in milliseconds)
SEND_DELAY_MS=2000
# Maximum retry attempts for transient errors
MAX_RETRIES=3
# Max recipients allowed per campaign
MAX_RECIPIENTS=100
